# Copiar a .env y completar. NUNCA versionar .env: las claves son secretos.
# Las claves de Stripe salen de https://dashboard.stripe.com/test/apikeys
# y el secreto del webhook, de `stripe listen --forward-to localhost:5000/api/pagos/webhook`.

# --- Base de datos ---
# SQLite en desarrollo. Produccion: postgresql+psycopg://usuario:clave@host:5432/goaltime
DATABASE_URL=sqlite:///goaltime.db

# --- Autenticacion ---
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=cambiar-en-local-por-uno-aleatorio
JWT_ACCESS_TOKEN_HOURS=12

# --- Pasarela de pago ---
# stripe | mock  (mock permite tests y demostraciones sin claves)
PAGADORA=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe trabaja en la unidad minima de la moneda; 'cop' = pesos colombianos sin decimales
STRIPE_CURRENCY=cop
# Base publica de la app; de aqui salen las URLs de retorno de Stripe Checkout.
# Con un dispositivo Android real debe ser la IP del PC (http://192.168.18.21:5000).
APP_URL_BASE=http://localhost:5000

# --- Servidor ---
FLASK_DEBUG=1
CORS_ORIGINS=*

# --- Asistente de lenguaje natural (spec.md 3.6) ---
# mock | ollama | gemini
#   mock   -> responde con reglas, sin red y sin modelo. Es el que corre en los tests, y
#             el unico que funciona sin instalar nada mas.
#   ollama -> corre en esta maquina, nada sale del equipo. Requiere `ollama serve` y un
#             modelo descargado (`ollama pull qwen2.5:3b`).
#   gemini -> sale a la red y necesita la llave de abajo.
LLM_PROVEEDOR=mock

# Solo para LLM_PROVEEDOR=ollama. En una maquina con menos de 4 GB libres un 7B no
# arranca; qwen2.5:3b es el mayor que se ha probado aqui (ver PLAN.md 3.1).
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELO=qwen2.5:3b

# Solo para LLM_PROVEEDOR=gemini. La llave es del BACKEND y nunca de la app: una llave
# dentro de un APK es una llave publica (spec.md 3.6 y 7.2).
GEMINI_API_KEY=
# Los 2.0/2.5 estan retirados o restringidos para proyectos nuevos. La familia 3.x
# vigente; 3.6-flash es la que se probo con la llave del despliegue (ver PLAN.md A-4).
GEMINI_MODELO=gemini-3.6-flash

# Canchas que el motor `mock` sabe nombrar, separadas por coma. El mock no consulta la
# base, asi que necesita que le digan cuales existen. Vacio = no reconoce ninguna.
LLM_MOCK_CANCHAS=
