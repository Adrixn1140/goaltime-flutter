# Configurar EN RAILWAY. No copiar secretos al APK ni subir un .env real al repositorio.
GOALTIME_ENV=production
FLASK_DEBUG=0
JWT_SECRET_KEY=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_DE_64_CARACTERES
# Copiar desde Supabase > Connect > Session pooler. No inventar el host.
# Usar puerto 5432, contraseña percent-encoded y SSL. Solo en el backend.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:ENCODED_PASSWORD@SESSION_POOLER_HOST:5432/postgres?sslmode=require
APP_URL_BASE=https://TU_SERVICIO.up.railway.app
WEB_CONCURRENCY=1
# No usamos un frontend web. CORS no sustituye la autorización del backend.
CORS_ORIGINS=https://TU_SERVICIO.up.railway.app
LLM_PROVEEDOR=mock
# PILOTO SIN COBROS REALES: autorización explícita para pagos simulados.
# No anunciar como sistema de cobro real. Para cobrar: stripe, sus claves y webhook HTTPS.
PAGADORA=mock
ALLOW_MOCK_PAYMENTS=1
