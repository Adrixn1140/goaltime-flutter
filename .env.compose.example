# Copiar a .env en la raíz y completar. docker compose lo lee de aquí.
# NUNCA versionar .env: JWT_SECRET_KEY es un secreto (spec.md 7.2).

# Sin esta variable el `docker compose up` se niega a arrancar: el valor por defecto de
# la configuración (`dev-secret-cambiar-en-produccion`) está en el repo y con él se
# puede firmar el token de cualquier rol, incluido admin.
JWT_SECRET_KEY=

POSTGRES_USER=goaltime
POSTGRES_PASSWORD=goaltime-local
POSTGRES_DB=goaltime
PUERTO_API=5000

# En producción se acota al dominio real de la app (HEUR-5).
CORS_ORIGINS=*

# mock recorre el flujo de pago sin claves de Stripe; stripe necesita las dos claves.
PAGADORA=mock
APP_URL_BASE=http://localhost:5000
